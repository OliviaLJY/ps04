  },
  {
    "segment_id": "yt-0017",
    "start_seconds": 42.88,
    "end_seconds": 47.080000000000005,
    "text": "you'll no longer have to configure local"
  },
  {
    "segment_id": "yt-0018",
    "start_seconds": 44.56,
    "end_seconds": 48.92,
    "text": "models in GitHub Copilot itself. Any"
  },
  {
    "segment_id": "yt-0019",
    "start_seconds": 47.08,
    "end_seconds": 50.879999999999995,
    "text": "models that you have installed with"
  },
  {
    "segment_id": "yt-0020",
    "start_seconds": 48.92,
    "end_seconds": 53.400000000000006,
    "text": "supported providers such as Microsoft"
  },
  {
    "segment_id": "yt-0021",
    "start_seconds": 50.88,
    "end_seconds": 55.400000000000006,
    "text": "Foundry Local or Ollama will just"
  },
  {
    "segment_id": "yt-0022",
    "start_seconds": 53.4,
    "end_seconds": 57.44,
    "text": "automatically be discovered and will"
  },
  {
    "segment_id": "yt-0023",
    "start_seconds": 55.4,
    "end_seconds": 59.48,
    "text": "appear in the model picker."
  },
  {
    "segment_id": "yt-0024",
    "start_seconds": 57.44,
    "end_seconds": 62.559999999999995,
    "text": "Capable devices will also be able to"
  },
  {
    "segment_id": "yt-0025",
    "start_seconds": 59.48,
    "end_seconds": 64.64,
    "text": "install MAI Code 1.1/"
  },
  {
    "segment_id": "yt-0026",
    "start_seconds": 62.56,
    "end_seconds": 67.36,
    "text": "a local model available for install"
  },
  {
    "segment_id": "yt-0027",
    "start_seconds": 64.64,
    "end_seconds": 70.08,
