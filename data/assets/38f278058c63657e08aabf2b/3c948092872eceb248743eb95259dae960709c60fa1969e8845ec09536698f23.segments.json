[
  {
    "segment_id": "yt-0001",
    "start_seconds": 0.0,
    "end_seconds": 5.36,
    "text": "Intelligent local model routing is"
  },
  {
    "segment_id": "yt-0002",
    "start_seconds": 2.6,
    "end_seconds": 8.4,
    "text": "coming to GitHub Copilot. A few weeks"
  },
  {
    "segment_id": "yt-0003",
    "start_seconds": 5.36,
    "end_seconds": 10.36,
    "text": "ago, we announced Project Hydra Fusion,"
  },
  {
    "segment_id": "yt-0004",
    "start_seconds": 8.4,
    "end_seconds": 12.84,
    "text": "an intelligent model orchestration that"
  },
  {
    "segment_id": "yt-0005",
    "start_seconds": 10.36,
    "end_seconds": 15.12,
    "text": "plans, implements, and executes across a"
  },
  {
    "segment_id": "yt-0006",
    "start_seconds": 12.84,
    "end_seconds": 17.48,
    "text": "wide range of cloud models, giving you"
  },
  {
    "segment_id": "yt-0007",
    "start_seconds": 15.12,
    "end_seconds": 21.68,
    "text": "frontier-level performance while"
  },
  {
    "segment_id": "yt-0008",
    "start_seconds": 17.48,
    "end_seconds": 24.560000000000002,
    "text": "significantly reducing cost up to 67%."
  },
  {
    "segment_id": "yt-0009",
    "start_seconds": 21.68,
    "end_seconds": 26.439999999999998,
    "text": "But our vision goes beyond just the"
  },
  {
    "segment_id": "yt-0010",
    "start_seconds": 24.56,
    "end_seconds": 29.72,
    "text": "models that are available in the cloud"
  },
  {
    "segment_id": "yt-0011",
    "start_seconds": 26.44,
    "end_seconds": 32.96,
    "text": "because we think that unlimited and"
  },
  {
    "segment_id": "yt-0012",
    "start_seconds": 29.72,
    "end_seconds": 34.76,
    "text": "unmetered intelligence belongs on every"
  },
  {
    "segment_id": "yt-0013",
    "start_seconds": 32.96,
    "end_seconds": 37.24,
    "text": "desktop. This is why we're pleased to"
  },
  {
    "segment_id": "yt-0014",
    "start_seconds": 34.76,
    "end_seconds": 39.559999999999995,
    "text": "announce that soon, Copilot will"
  },
  {
    "segment_id": "yt-0015",
    "start_seconds": 37.24,
    "end_seconds": 42.88,
    "text": "intelligently route to and leverage"
  },
  {
    "segment_id": "yt-0016",
    "start_seconds": 39.56,
    "end_seconds": 44.56,
